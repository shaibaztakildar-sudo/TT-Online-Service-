rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'shaibaztakildar@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'shaibaztakildar@gmail.com')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() > 0 &&
        data.email is string &&
        data.role in ['customer', 'admin'];
    }

    function isValidApplication(data) {
      return data.applicationId is string && data.applicationId.size() > 0 &&
        data.userId is string && data.userId.size() > 0 &&
        data.customerName is string &&
        data.serviceId is string &&
        data.serviceName is string &&
        data.consentGiven == true;
    }

    function isValidPayment(data) {
      return data.paymentId is string && data.paymentId.size() > 0 &&
        data.applicationId is string && data.applicationId.size() > 0 &&
        data.userId is string && data.userId.size() > 0 &&
        data.amount is number && data.amount >= 0 &&
        data.currency == 'INR';
    }

    function isValidNotification(data) {
      return data.notificationId is string && data.notificationId.size() > 0 &&
        data.userId is string && data.userId.size() > 0 &&
        data.title is string && data.title.size() > 0;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isOwnerAdmin();
      allow create: if isOwner(userId) &&
                      isValidUser(request.resource.data) &&
                      (request.resource.data.role == 'customer' || isOwnerAdmin());
      allow update: if (isOwner(userId) || isOwnerAdmin()) &&
                      isValidUser(request.resource.data) &&
                      (isOwnerAdmin() || request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    // Applications collection
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid &&
                      isValidApplication(request.resource.data);
      allow update: if isAuthenticated() && (
                      isOwnerAdmin() ||
                      (resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid)
                    ) &&
                    isValidApplication(request.resource.data);
      allow delete: if isOwnerAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isOwnerAdmin()) &&
                      isValidPayment(request.resource.data);
      allow update: if isOwnerAdmin() && isValidPayment(request.resource.data);
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isOwnerAdmin()) &&
                      isValidNotification(request.resource.data);
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwnerAdmin());
    }

    // Payment Webhook Audit Logs
    match /payment_webhooks/{webhookId} {
      allow read, write: if isOwnerAdmin();
    }
  }
}
